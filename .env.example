# Stripe — server-side only (GitHub Pages / Netlify environment variables, never commit real keys)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
# Map explore product IDs to Stripe Price IDs (from Dashboard → Products)
STRIPE_PRICE_IDS={"1":"price_REPLACE","2":"price_REPLACE","3":"price_REPLACE","4":"price_REPLACE","5":"price_REPLACE","6":"price_REPLACE","7":"price_REPLACE"}
# Optional fallback if host headers are missing locally
SITE_URL=https://eekseye.com

# FedEx Ship API (see FEDEX_SETUP.md) — never commit real secrets
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
